<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">My Properties</h1>
  <%= link_to "New Property", new_property_path, class: "btn btn-success" %>
</div>

<% if @properties.empty? %>
  <p>You have no properties yet.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Address</th>
          <th>Price</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @properties.each do |property| %>
          <tr>
            <td><%= property.name %></td>
            <td><%= property.address %></td>
            <td><%= property.price %></td>
            <td><%= property.status %></td>
            <td>
              <%= link_to "Show", property_path(property) %>
              <%= link_to "Edit", edit_property_path(property), class: "ml-2" %>
              <%= link_to "Destroy", property_path(property),
                    method: :delete,
                    data: { confirm: "Delete this property?" },
                    class: "ml-2 text-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
