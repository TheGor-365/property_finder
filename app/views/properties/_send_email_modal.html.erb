<% agent_message = @agent_message || AgentMessage.new(account: agent) %>
<% invalid = agent_message.errors.any? %>
<div class="modal fade" id="contact-modal" tabindex="-1" role="dialog"
     aria-labelledby="profile-contact-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="h5 modal-title" id="profile-contact-title">Message <%= agent.full_name.presence || 'the agent' %></h2>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <%= form_with scope: :agent_message, url: profile_email_agent_path(agent), local: true do |form| %>
        <div class="modal-body">
          <% if invalid %>
            <div class="alert alert-danger" role="alert">
              <strong>Please check your message:</strong>
              <ul class="mb-0"><% agent_message.errors.full_messages.each do |error| %><li><%= error %></li><% end %></ul>
            </div>
          <% end %>
          <div class="form-group">
            <%= form.label :name, 'Your name' %>
            <%= form.text_field :name, value: agent_message.name, class: 'form-control', required: true, maxlength: 120, autocomplete: 'name' %>
          </div>
          <div class="form-group">
            <%= form.label :email, 'Email address' %>
            <%= form.email_field :email, value: agent_message.email, class: 'form-control', required: true, maxlength: 254, autocomplete: 'email' %>
          </div>
          <div class="form-group">
            <%= form.label :message, 'Your message' %>
            <%= form.text_area :message, value: agent_message.message, class: 'form-control', rows: 5, required: true, minlength: 10, maxlength: 2000 %>
          </div>
          <div class="pf-enquiry-honeypot" aria-hidden="true">
            <%= form.label :website, 'Leave this field empty' %>
            <%= form.text_field :website, value: '', tabindex: -1, autocomplete: 'off' %>
          </div>
          <p class="text-muted small mb-0">
            Your message will be saved in the agent's private inbox. Email delivery is not guaranteed.
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
          <%= form.submit 'Send message', class: 'btn btn-success' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% if invalid %>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (window.jQuery && window.jQuery.fn.modal) {
        window.jQuery('#contact-modal').modal('show');
      }
    });
  </script>
<% end %>
