<% enquiry = @enquiry || Enquiry.new(property: @property) %>
<% invalid = enquiry.errors.any? %>
<div class="modal fade" id="contact-modal" tabindex="-1" role="dialog" aria-labelledby="detail-contact-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="h5 modal-title" id="detail-contact-title">Contact <%= agent.full_name.presence || 'listing agent' %></h2>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <%= form_with model: enquiry, url: enquiries_path, local: true, html: { id: 'email_agent' } do |form| %>
        <div class="modal-body">
          <%= form.hidden_field :property_id, value: @property.id %>
          <% if invalid %>
            <div class="alert alert-danger" role="alert">
              <strong>Check your enquiry:</strong>
              <ul class="mb-0"><% enquiry.errors.full_messages.each do |error| %><li><%= error %></li><% end %></ul>
            </div>
          <% end %>
          <div class="form-group">
            <%= form.label :name, 'Your name', for: 'message-first-name' %>
            <%= form.text_field :name, id: 'message-first-name', class: 'form-control', required: true, maxlength: 120, autocomplete: 'name' %>
          </div>
          <div class="form-group">
            <%= form.label :email, 'Email address', for: 'message-email' %>
            <%= form.email_field :email, id: 'message-email', class: 'form-control', required: true, maxlength: 254, autocomplete: 'email' %>
          </div>
          <div class="form-group">
            <%= form.label :message, 'Your message', for: 'message-text' %>
            <%= form.text_area :message, id: 'message-text', class: 'form-control', required: true, rows: 4, minlength: 10, maxlength: 2000 %>
          </div>
          <div class="pf-enquiry-honeypot" aria-hidden="true">
            <%= form.label :website, 'Leave this field empty' %>
            <%= text_field_tag 'enquiry[website]', '', tabindex: -1, autocomplete: 'off' %>
          </div>
          <p class="text-muted small mb-0">Your contact details and message will be shared with the listing agent.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
          <%= form.submit 'Send enquiry', class: 'btn btn-success' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% if invalid %>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (window.jQuery && window.jQuery.fn.modal) {
        window.jQuery('#contact-modal').modal('show');
      }
    });
  </script>
<% end %>
