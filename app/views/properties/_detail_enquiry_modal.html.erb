<div class="modal fade" id="contact-modal" tabindex="-1" role="dialog" aria-labelledby="detail-contact-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="h5 modal-title" id="detail-contact-title">Contact <%= agent.full_name.presence || 'listing agent' %></h2>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <div class="modal-body">
        <%= form_tag '/agent/message', id: 'email_agent' do %>
          <%= hidden_field_tag :agent_id, agent.id %>
          <div class="form-group">
            <%= label_tag 'message-first-name', 'First name' %>
            <%= text_field_tag :first_name, nil, id: 'message-first-name', class: 'form-control', required: true, maxlength: 80, autocomplete: 'given-name' %>
          </div>
          <div class="form-group">
            <%= label_tag 'message-last-name', 'Last name' %>
            <%= text_field_tag :last_name, nil, id: 'message-last-name', class: 'form-control', required: true, maxlength: 80, autocomplete: 'family-name' %>
          </div>
          <div class="form-group">
            <%= label_tag 'message-email', 'Email address' %>
            <%= email_field_tag :email, nil, id: 'message-email', class: 'form-control', required: true, maxlength: 254, autocomplete: 'email' %>
          </div>
          <div class="form-group">
            <%= label_tag 'message-text', 'Your message' %>
            <%= text_area_tag :message, nil, id: 'message-text', class: 'form-control', required: true, rows: 4, maxlength: 2000 %>
          </div>
        <% end %>
        <p class="text-muted small mb-0" role="note">Ask the agent a question about this property.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="send-message-to-agent">Send enquiry</button>
      </div>
    </div>
  </div>
</div>
