<div class="text-center">
  <div class="mb-3"><%= profile_picture agent %></div>
  <h3 class="h5 mb-1"><%= agent.full_name.presence || 'Listing agent' %></h3>
  <% if agent.company.present? %><p class="text-muted mb-3"><%= agent.company %></p><% end %>
  <div class="d-flex flex-column">
    <% if agent.telephone.present? %>
      <%= link_to "Call agent", "tel:#{agent.telephone.to_s.gsub(/[^\d+]/, '')}", class: 'btn btn-outline-success btn-block mb-2' %>
    <% end %>
    <button type="button" class="btn btn-success btn-block" data-toggle="modal" data-target="#contact-modal">
      <i class="fas fa-envelope mr-2" aria-hidden="true"></i>Send a message
    </button>
  </div>
  <p class="text-muted small mt-3 mb-0">Messages are stored in the agent's private inbox. Email notifications are best-effort.</p>
</div>
