<p class="pf-section-kicker mb-2">Agent workspace</p>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h2 mb-1">Dashboard</h1>
    <p class="text-muted mb-0">
      Overview of your property listings
    </p>
  </div>

  <%= link_to "Add Property",
      new_property_path,
      class: "btn btn-success" %>
</div>

<div class="pf-workspace-notice d-flex flex-wrap align-items-center justify-content-between p-3 mb-4">
  <div>
    <strong>Incoming requests</strong>
    <p class="text-muted mb-0"><%= pluralize(@new_enquiries_count, "new message") %> waiting for review</p>
  </div>
  <%= link_to "Open inbox", enquiries_path, class: "btn btn-outline-success btn-sm mt-2 mt-sm-0" %>
</div>

<div class="row">
  <% [
    ["Total Properties", @total_properties],
    ["For Sale", @for_sale_count],
    ["For Rent", @for_rent_count],
    ["Sold / Leased", @completed_count]
  ].each do |label, value| %>
    <div class="col-sm-6 col-lg-3 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <p class="text-muted mb-2"><%= label %></p>
          <h2 class="h3 mb-0"><%= value %></h2>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
  <h2 class="h4 mb-0">Recent Properties</h2>
  <%= link_to "View All", my_properties_path,
      class: "btn btn-outline-secondary btn-sm" %>
</div>

<% if @recent_properties.empty? %>
  <div class="border rounded p-4 text-center">
    <h3 class="h5">No properties yet</h3>
    <p class="text-muted">
      Create your first property listing to get started.
    </p>
    <%= link_to "Create Property",
        new_property_path,
        class: "btn btn-success" %>
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Property</th>
          <th>Price</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_properties.each do |property| %>
          <tr>
            <td><%= property.name %></td>
            <td><%= number_to_currency(property.price, precision: 0) %></td>
            <td><%= property.status %></td>
            <td>
              <%= link_to "Show", property_path(property) %>
              <%= link_to "Edit",
                  edit_property_path(property),
                  class: "ml-2" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
