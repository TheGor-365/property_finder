<nav class="navbar navbar-expand-md navbar-dark bg-dark pf-site-nav" aria-label="Main navigation">
  <div class="container">
    <a class="navbar-brand" href="<%= root_path %>">Property Finder</a>
    <button
      class="navbar-toggler"
      type="button"
      data-toggle="collapse"
      data-target="#navbarsExampleDefault"
      aria-controls="navbarsExampleDefault"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarsExampleDefault">
      <ul class="navbar-nav mr-auto">

        <li class="nav-item <%= 'active' if current_page?(root_path) %>">
          <%= link_to 'Home', root_path, class: 'nav-link', aria: { current: (current_page?(root_path) ? 'page' : nil) } %>
        </li>

        <li class="nav-item <%= 'active' if controller_name == 'properties' %>">
          <%= link_to 'Properties', properties_path, class: 'nav-link', aria: { current: (controller_name == 'properties' ? 'page' : nil) } %>
        </li>



        <li class="nav-item <%= 'active' if controller_name == 'posts' %>">
          <%= link_to 'Blog', blog_path, class: 'nav-link', aria: { current: (controller_name == 'posts' ? 'page' : nil) } %>
        </li>
        <% if account_signed_in? %>
          <li class="nav-item">
            <%= link_to 'Dashboard', dashboard_path, class: 'nav-link' %>
          </li>
        <% end %>


      </ul>

      <% if account_signed_in? %>
        <%= link_to 'Sign out', destroy_account_session_path, method: :delete, class: 'float-sm-right btn btn-secondary' %>
      <% else %>
        <%= link_to 'Log in', new_account_session_path, class: 'float-sm-right btn btn-secondary mr-2' %>
        <%= link_to 'Sign up', new_account_registration_path, class: 'float-sm-right btn btn-success' %>
      <% end %>
    </div>
  </div>
</nav>
