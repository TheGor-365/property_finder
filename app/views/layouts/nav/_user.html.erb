<% dashboard_active = current_page?(dashboard_path) %>
<% listings_active = current_page?(my_properties_path) ||
  (controller_name == "properties" && %w[new create edit update].include?(action_name)) %>
<% enquiries_active = current_page?(enquiries_path) %>
<li class="nav-item">
  <%= link_to dashboard_path, class: "nav-link", aria: { current: (dashboard_active ? "page" : nil) } do %>
    <i data-feather="home" aria-hidden="true"></i> Dashboard
  <% end %>
</li>
<li class="nav-item">
  <%= link_to my_properties_path, class: "nav-link", aria: { current: (listings_active ? "page" : nil) } do %>
    <i data-feather="package" aria-hidden="true"></i> My Properties
  <% end %>
</li>
<li class="nav-item">
  <%= link_to enquiries_path, class: "nav-link", aria: { current: (enquiries_active ? "page" : nil) } do %>
    <i data-feather="inbox" aria-hidden="true"></i> Enquiries
  <% end %>
</li>
