<% if flash[:notice].present? || flash[:alert].present? %>
  <div id="flash-messages" class="<%= @show_sidebar.present? ? 'mb-4' : 'container mt-3' %>" aria-live="polite">
    <% %w[notice alert].each do |kind| %>
      <% message = flash[kind] %>
      <% next if message.blank? %>
      <div class="alert <%= kind == "notice" ? "alert-success" : "alert-danger" %>" role="alert">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>
