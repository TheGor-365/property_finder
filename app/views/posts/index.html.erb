<section class="pf-workspace-section">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div><p class="pf-section-kicker mb-2">Editorial workspace</p><h1 class="h2 mb-1">Blog posts</h1><p class="text-muted mb-0">Create and manage published guides.</p></div>
    <%= link_to 'New article', new_post_path, class: 'btn btn-success mt-2' %>
  </div>
  <% if @posts.empty? %>
    <div class="pf-empty-state p-4">
      <h2 class="h5">No articles yet</h2>
      <p class="text-muted">Create the first guide to populate the public blog.</p>
      <%= link_to 'Write an article', new_post_path, class: 'btn btn-success' %>
    </div>
  <% else %>
    <div class="pf-workspace-card table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Article</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead>
        <tbody>
          <% @posts.order(updated_at: :desc).each do |post| %>
            <tr>
              <td><strong><%= post.title %></strong><div class="text-muted small"><%= truncate(post.summary.to_s, length: 100) %></div></td>
              <td><span class="badge <%= post.active? ? 'badge-success' : 'badge-secondary' %>"><%= post.active? ? 'Published' : 'Draft' %></span></td>
              <td><%= l(post.updated_at.to_date, format: :long) %></td>
              <td>
                <%= link_to 'View', post_path(post), class: 'btn btn-outline-secondary btn-sm mr-1' %>
                <%= link_to 'Edit', edit_post_path(post), class: 'btn btn-outline-success btn-sm mr-1' %>
                <%= button_to 'Delete', post_path(post), method: :delete,
                    data: { confirm: 'Permanently delete this article?' },
                    class: 'btn btn-outline-danger btn-sm mt-2' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
