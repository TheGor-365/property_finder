<main class="pf-auth-page" role="main">
  <section class="pf-auth-card" aria-labelledby="registration-title">
    <p class="pf-section-kicker mb-2">Start with Property Finder</p>
    <h1 class="h2 mb-2" id="registration-title">Create an account</h1>
    <p class="text-muted mb-4">Join the demonstration workspace to manage your own listings.</p>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>
      <div class="row">
        <div class="col-sm-6 form-group"><%= f.label :first_name %><%= f.text_field :first_name, autofocus: true, autocomplete: 'given-name', class: 'form-control', required: true %></div>
        <div class="col-sm-6 form-group"><%= f.label :last_name %><%= f.text_field :last_name, autocomplete: 'family-name', class: 'form-control', required: true %></div>
      </div>
      <div class="form-group"><%= f.label :email %><%= f.email_field :email, autocomplete: 'email', class: 'form-control', required: true %></div>
      <div class="form-group"><%= f.label :password %><%= f.password_field :password, autocomplete: 'new-password', class: 'form-control', required: true %></div>
      <div class="form-group"><%= f.label :password_confirmation %><%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'form-control', required: true %></div>
      <%= f.submit 'Create account', class: 'btn btn-success btn-lg btn-block' %>
    <% end %>
    <div class="mt-4 text-center"><%= render 'devise/shared/links' %></div>
  </section>
</main>
