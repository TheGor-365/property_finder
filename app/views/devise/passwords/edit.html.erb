<main class="pf-auth-page" role="main">
  <section class="pf-auth-card" aria-labelledby="change-title">
    <p class="pf-section-kicker mb-2">Account recovery</p>
    <h1 class="h2 mb-2" id="change-title">Choose a new password</h1>
    <p class="text-muted mb-4">Use a strong, unique password for this account.</p>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>
      <div class="form-group">
        <%= f.label :password, 'New password' %>
        <%= f.password_field :password, autofocus: true, autocomplete: 'new-password', class: 'form-control', required: true %>
        <% if @minimum_password_length %><small class="text-muted">At least <%= @minimum_password_length %> characters.</small><% end %>
      </div>
      <div class="form-group"><%= f.label :password_confirmation, 'Confirm new password' %><%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'form-control', required: true %></div>
      <%= f.submit 'Change password', class: 'btn btn-success btn-lg btn-block' %>
    <% end %>
    <div class="text-center mt-4"><%= render "devise/shared/links" %></div>
  </section>
</main>
