<main class="pf-auth-page" role="main">
  <section class="pf-auth-card" aria-labelledby="reset-title">
    <p class="pf-section-kicker mb-2">Account recovery</p>
    <h1 class="h2 mb-2" id="reset-title">Reset your password</h1>
    <p class="text-muted mb-4">Enter the email associated with your account. If it exists, we'll send reset instructions.</p>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="form-group"><%= f.label :email, 'Account email' %><%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'form-control', required: true %></div>
      <%= f.submit 'Send reset instructions', class: 'btn btn-success btn-lg btn-block' %>
    <% end %>
    <div class="text-center mt-4"><%= render "devise/shared/links" %></div>
  </section>
</main>
